# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env ขึ้น git เด็ดขาด)
# ตอน deploy ขึ้นเซิร์ฟเวอร์ ให้ไปตั้งค่าพวกนี้ในหน้า Environment Variables ของผู้ให้บริการแทน

# ---- ฐานข้อมูล Supabase ----
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# ---- token ให้ Node-RED/เซนเซอร์ยิงข้อมูลเข้ามา ----
INGEST_TOKEN=

# ---- AI ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# ถ้าจะใช้ Ollama ในเครื่องเป็นตัวสำรอง
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---- รหัสผ่าน admin คนแรก (ใช้ตอนยังไม่มีผู้ใช้ในตาราง admin_users) ----
ADMIN_PASSWORD=

# ---- URL สาธารณะของ backend (ใช้ประกอบลิงก์ไฟล์ที่ส่งเข้า LINE) ----
# ห้ามใส่ / ต่อท้าย เช่น https://farmy-api.onrender.com
PUBLIC_BASE_URL=

# ---- โดเมนของเว็บ frontend ที่อนุญาตให้เรียก API (คั่นด้วย , ได้) ----
# ไม่ตั้ง = อนุญาตทุกโดเมน (สะดวกตอน dev แต่ production ควรระบุ)
ALLOWED_ORIGINS=https://farmy.vercel.app

# ---- LINE Official Account ----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

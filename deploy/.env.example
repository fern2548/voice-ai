# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าให้ครบ
# ห้าม commit ไฟล์ .env ขึ้น git เด็ดขาด

# ── ฐานข้อมูล ─────────────────────────────────────
# ตั้งเองยาว ๆ สุ่ม ๆ ใช้ครั้งเดียวตอนสร้างฐานข้อมูล
DB_PASSWORD=

# รหัสลับสำหรับเซ็นกุญแจ ต้องยาวอย่างน้อย 32 ตัวอักษร
JWT_SECRET=

# ได้จากการสั่ง  python make-key.py  (ต้องตั้ง JWT_SECRET ก่อน)
SUPABASE_SERVICE_KEY=

# ── ที่อยู่ ────────────────────────────────────────
# ที่อยู่ที่ "เบราว์เซอร์ของผู้ใช้" จะเรียกเซิร์ฟเวอร์
# ในเครื่องเดียวกัน: http://localhost:8000
# เครื่องอื่นในออฟฟิศ: http://192.168.1.50:8000
# มีโดเมนจริง: https://api.ชื่อโดเมน.com
PUBLIC_API_URL=http://localhost:8000

# ที่อยู่เซิร์ฟเวอร์ ใช้สร้างลิงก์รายงานที่ส่งเข้า LINE
PUBLIC_BASE_URL=http://localhost:8000
# ที่อยู่หน้าเว็บ ใช้แนบท้ายข้อความแจ้งเตือน
PUBLIC_SITE_URL=http://localhost:8080

# ── ความปลอดภัย ───────────────────────────────────
ADMIN_PASSWORD=
INGEST_TOKEN=
SESSION_SECRET=
PUBLIC_REPORT_KEY=
CRON_KEY=

# ── บริการภายนอก (ไม่ใส่ก็ยังใช้งานได้) ──────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CPF_API_KEY=
CPF_API_BASE=
CPF_MODEL=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14

# รหัสเชิญสำหรับสมัครบัญชีเอง (เว้นว่าง = ปิดการสมัครเอง)
SIGNUP_CODE=

# API เซนเซอร์ภายนอก lab.plotnexuslab.com (ว่าง = ไม่ใช้)
LAB_API_KEY=

# ส่งข้อมูลฟาร์มเราขึ้น "พื้นที่ของฉัน" บน lab (เว้นว่าง = ไม่ส่ง)
# ใช้บัญชี lab ของคุณ ไม่ใช่คีย์ labro_
LAB_USER=fern
LAB_PASSWORD=
LAB_WRITE_TABLE=farmy
LAB_WRITE_LOCATION=saraburi_farm

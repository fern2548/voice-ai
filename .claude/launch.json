{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "farmy-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "farmy-dashboard-zip",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "C:/farmy-dashboard",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "farmy-api",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "backend",
      "port": 8000,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "WEB_DIST": "C:/nonexistent"
      }
    },
    {
      "name": "farmy-voice-ai",
      "runtimeExecutable": "C:/farmy-voice-ai/backend/venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "voice_server:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8010"
      ],
      "cwd": "C:/farmy-voice-ai/backend",
      "port": 8010,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ]
}